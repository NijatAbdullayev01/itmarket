{
  "name": "@itmarket/backoffice",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "export NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1 API_ORIGIN=http://localhost:4000 && bash ../../scripts/wait-for-api.sh && next dev --webpack --port 4002",
    "build": "node -e \"fs.rmSync('.next/standalone', { recursive: true, force: true })\" && next build && node ../../scripts/copy-next-standalone-assets.mjs",
    "start": "node .next/standalone/apps/backoffice/server.js",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@itmarket/contracts": "workspace:*",
    "@itmarket/ui": "workspace:*",
    "@next/env": "16.2.10",
    "@zxing/browser": "^0.2.1",
    "next": "16.2.10",
    "pdfmake": "^0.3.11",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfmake": "^0.3.3",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
