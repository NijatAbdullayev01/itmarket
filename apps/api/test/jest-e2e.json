{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": ".",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "setupFiles": ["<rootDir>/setup-env.ts"],
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/tsconfig.jest-e2e.json"
      }
    ]
  },
  "moduleNameMapper": {
    "^(\\.{1,2}/.*)\\.js$": "$1",
    "^@itmarket/contracts$": "<rootDir>/../../../packages/contracts/src/index.ts",
    "^@itmarket/contracts/(.*)$": "<rootDir>/../../../packages/contracts/src/$1"
  },
  "transformIgnorePatterns": [
    "/node_modules/(?!(?:\\.pnpm/[^/]+/node_modules/)?(?:otplib|@otplib|@scure|@noble)(?:/|$))"
  ]
}
