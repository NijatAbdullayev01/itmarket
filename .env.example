# Local development only. Copy to .env; never reuse these values outside a
# developer workstation. Services bind to loopback by default.
NODE_ENV=development
PORT=3001
LOG_LEVEL=debug
# Optional deploy metadata injected by CI/CD for traceability.
# RELEASE_SHA=
# Required in production. Prometheus sends this as a Bearer token; store the
# real value in a secret manager and rotate it like any machine credential.
# METRICS_TOKEN=
APP_SECRET=local_application_secret_change_me_123456
# Production rejects this example secret and any value containing change-me / example.
# TRUST_PROXY_HOPS=0
# Express trust-proxy hop count for rate-limit client IP (X-Forwarded-For).
# Default 0 ignores XFF (safe when the API is exposed directly — clients cannot
# spoof rate-limit buckets). Set to the number of *trusted* reverse proxies that
# append XFF (usually 1 behind nginx/Caddy/LB). Too high = client spoof; too low
# = all clients share the proxy IP. Production requires this variable explicitly
# (no silent default). Do not parse vendor client-IP headers in app code.
# D-011: production requires STAFF_MFA_REQUIRED=true (env validation).
# Local/dev default false so enrollment flows work without MFA.
# STAFF_MFA_REQUIRED=false
# Recurring jobs (payment expiry, notification outbox, report exports).
# Local/dev: leave true on the API process. Production: API=false, worker=true.
# JOBS_ENABLED=true
PAYMENT_PROVIDER=mock
# POS fiscal receipt: none (disabled) | log (staging rehearsal only; not legal e-kassa).
# Official provider adapter is added after D-010 closes.
FISCAL_RECEIPT_PROVIDER=none
# Epoint hosted checkout uses merchant-configured result_url and these keys when
# PAYMENT_PROVIDER=epoint is selected.
# EPOINT_PUBLIC_KEY=
# EPOINT_PRIVATE_KEY=
# Optional merchant-confirmed installment mapping for Epoint hosted checkout.
# Comma-separated month list, e.g. 3,6,12
# EPOINT_INSTALLMENT_MONTHS=
# Optional minimum order total required before installment is offered.
# EPOINT_INSTALLMENT_MINIMUM=
# Extra hosts allowed for provider checkout redirects (comma-separated).
# epoint.az and www.epoint.az are always allowed.
# PAYMENT_REDIRECT_HOSTS=
STOREFRONT_ORIGIN=http://localhost:3010
API_ORIGIN=http://localhost:3001
BACKOFFICE_ORIGIN=http://localhost:3002
NEXT_PUBLIC_API_URL=http://localhost:3001/api/v1
# Optional SEO / social (storefront).
# Required in production: without STOREFRONT_ORIGIN the storefront fails closed
# (site-wide noindex, empty sitemap, robots disallow all).
# GOOGLE_SITE_VERIFICATION=
TWITTER_SITE=@itmarket
# Optional LocalBusiness geo (WGS84) for Organization JSON-LD.
STORE_GEO_LATITUDE=40.3777
STORE_GEO_LONGITUDE=49.8520
# Comma-separated hostnames allowed for next/image (in addition to local MinIO).
# IMAGE_REMOTE_HOSTS=cdn.example.com,media.example.com

# Optional catalog SEO AI (backoffice «AI ilə SEO yaz») — Gemini by default.
# Scope: SEO title/description only. The API never sends payment, order, or
# customer PII to the provider (allowlist + pattern gate in seo-ai-boundary).
# Do not put Epoint/payment keys here — use a dedicated Gemini / SEO LLM key.
# Without SEO_AI_API_KEY the API still returns heuristic Azerbaijani SEO copy.
# SEO_AI_API_KEY=
# SEO_AI_BASE_URL must be HTTPS on an allowlisted host
# (generativelanguage.googleapis.com | api.openai.com | api.anthropic.com).
# SEO_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# SEO_AI_MODEL=gemini-3.5-flash
# SEO_AI_TIMEOUT_MS=30000
# Staff idle timeout (ms); absolute session TTL remains 7 days.
# STAFF_INACTIVITY_TTL_MS=1800000
# Signed webhook replay window (seconds).
# WEBHOOK_MAX_AGE_SECONDS=900
# Note: nest --watch children inherit stale process.env; API loads ../../.env
# on boot (apps/api/src/config/load-env.ts). Production never overrides
# platform/secret-manager env that is already set.
# Other OpenAI-compatible hosts require a code allowlist update
# (SEO_AI_ALLOWED_HOSTS in apps/api/src/security/outbound-url.ts).

# Optional development seed administrator. Set both explicitly; no credential
# is supplied by the repository.
# SEED_STAFF_EMAIL=
# SEED_STAFF_PASSWORD=

POSTGRES_BIND_ADDRESS=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=itmarket_local
POSTGRES_USER=itmarket_local
POSTGRES_PASSWORD=local_itmarket_postgres_only
DATABASE_URL=postgresql://itmarket_local:local_itmarket_postgres_only@localhost:5432/itmarket_local?schema=public

REDIS_BIND_ADDRESS=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=local_itmarket_redis_only
REDIS_URL=redis://:local_itmarket_redis_only@localhost:6379/0

MINIO_BIND_ADDRESS=127.0.0.1
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=itmarket_local
MINIO_ROOT_PASSWORD=local_itmarket_minio_only_ChangeOutsideLocal
MINIO_BUCKET=itmarket-local
# Product media storage: local filesystem (default in development) or s3/MinIO.
# Production defaults to s3 and rejects MEDIA_STORAGE=local.
MEDIA_STORAGE=local
# D-013 malware gate: local (magic/structure/polyglot) or clamav (+ clamd).
MEDIA_MALWARE_SCAN=local
# CLAMAV_HOST=127.0.0.1
# CLAMAV_PORT=3310
# S3/MinIO settings used when MEDIA_STORAGE=s3. Defaults match local MinIO.
# Production requires non-empty, non-localhost S3_* credentials.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_ACCESS_KEY=itmarket_local
S3_SECRET_KEY=local_itmarket_minio_only_ChangeOutsideLocal
S3_BUCKET=itmarket-local
S3_FORCE_PATH_STYLE=true

MAILPIT_BIND_ADDRESS=127.0.0.1
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_SECURE=false
# Optional SMTP AUTH (required by many production relays; unused by local Mailpit).
# SMTP_USER=
# SMTP_PASS=
EMAIL_FROM=ITMarket Local <no-reply@itmarket.local>
# Production forbids FISCAL_RECEIPT_PROVIDER=log (rehearsal-only synthetic receipts).
